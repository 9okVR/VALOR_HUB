--[[
    VALOR EXECUTOR CHECK
    An overall executor test, like UNC / sUNC: every function scripts commonly
    use is checked by actually USING it, not just by name (the full UNC list,
    the newer sUNC-style ones, and common extras like firetouchinterest).
    Then extra checks: game modules, thread rules, file safety, speed.

    Run it inside a game (one built on Knit, like Volleyball Legends, tests
    the most). Results: a window (click a row to read its full message;
    "Problems only" hides what passed) and valor_check.txt in the workspace.
    Nothing is printed: some games upload their console.

    Safe to run: it never clicks, types, changes your clipboard, FPS cap or
    teleport queue, never opens a console or message box, never hooks the
    game, never connects anywhere but GitHub. Those functions are only
    checked for presence ("SKIP").
]]

local Players = game:GetService("Players")
local RS = game:GetService("ReplicatedStorage")
local RF = game:GetService("ReplicatedFirst")
local UIS = game:GetService("UserInputService")
local LP = Players.LocalPlayer

local ENV = getfenv(1)
-- "crypt.base64encode" -> the function, or nil
local function resolve(path)
    local cur = ENV
    for part in string.gmatch(path, "[^%.]+") do
        local ok, v = pcall(function() return cur[part] end)
        if not ok or v == nil then return nil end
        cur = v
    end
    return cur
end

-- ===================================================================
--  test runner
-- ===================================================================
-- status: PASS (works) / ALIAS (works under another name) / FAIL (there,
-- but wrong or erroring) / MISSING / SKIP (there, not run on purpose) /
-- INFO (a fact, not a pass or fail) / WARN (works, but risky)
local groups, current = {}, nil
local function group(name, isExtra)
    current = {name = name, extra = isExtra, items = {}}
    table.insert(groups, current)
end

-- run fn(f) on its own thread, give it `secs` at most
local function runTimed(fn, f, secs)
    local done, ok, a, b = false, false, nil, nil
    task.spawn(function()
        ok, a, b = pcall(fn, f)
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (secs or 4) do task.wait() end
    if not done then return false, "timed out after " .. (secs or 4) .. "s" end
    if not ok then return false, tostring(a) end
    if a == false then return false, tostring(b or "wrong result") end
    return true, (a ~= true and a ~= nil) and tostring(a) or nil
end

-- test("name", {aliases}, fn) -- fn gets the function, returns true /
-- a detail string / false + why; errors count as FAIL. fn == "skip" only
-- checks presence.
local function test(name, aliases, fn, secs)
    local item = {name = name}
    table.insert(current.items, item)
    local f, used = resolve(name), name
    if f == nil then
        for _, a in ipairs(aliases or {}) do
            f = resolve(a)
            if f ~= nil then used = a; break end
        end
    end
    if f == nil then
        item.status, item.detail = "MISSING", "not found" .. ((aliases and #aliases > 0) and (" (also tried " .. table.concat(aliases, ", ") .. ")") or "")
        return
    end
    local aliasNote = used ~= name and ("as " .. used) or nil
    if fn == "skip" then
        item.status, item.detail = "SKIP", "present" .. (aliasNote and (" " .. aliasNote) or "") .. " - not run (it would act on your game or PC)"
        return
    end
    if not fn then
        item.status, item.detail = aliasNote and "ALIAS" or "PASS", aliasNote or "present"
        return
    end
    local ok, detail = runTimed(fn, f, secs)
    if ok then
        item.status = aliasNote and "ALIAS" or "PASS"
        item.detail = (aliasNote and (aliasNote .. (detail and " - " or "")) or "") .. (detail or "")
        if item.detail == "" then item.detail = "works" end
    else
        item.status, item.detail = "FAIL", (aliasNote and (aliasNote .. ": ") or "") .. detail
    end
end

-- extras: fn returns status, detail
local function extra(name, fn, secs)
    local item = {name = name}
    table.insert(current.items, item)
    local done, s, d = false, nil, nil
    task.spawn(function()
        local ok, a, b = pcall(fn)
        if ok then s, d = a, b else s, d = "FAIL", tostring(a) end
        done = true
    end)
    local t0 = os.clock()
    while not done and os.clock() - t0 < (secs or 5) do task.wait() end
    if not done then s, d = "FAIL", "timed out" end
    item.status, item.detail = s or "INFO", d or ""
end

-- check("name", fn): a function test that isn't one function's name (fn
-- returns like a test's, or "MISSING", why)
local function check(name, fn, secs)
    local item = {name = name}
    table.insert(current.items, item)
    local ok, detail = runTimed(fn, nil, secs)
    if ok and detail == "MISSING" then
        item.status, item.detail = "MISSING", "not found"
        return
    end
    item.status = ok and "PASS" or "FAIL"
    item.detail = ok and (detail or "works") or detail
end

local function G(name) return resolve(name) end
