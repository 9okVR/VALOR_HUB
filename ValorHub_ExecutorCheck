group("Closures")
test("checkcaller", nil, function(f) return f() or false, "should be true when called from your own script" end)
test("clonefunction", nil, function(f)
    local function a() return "valor" end
    local b = f(a)
    if a == b then return false, "returned the same function" end
    return b() == "valor" or false, "the clone doesn't behave like the original"
end)
test("hookfunction", {"replaceclosure"}, function(f)
    local function target() return "original" end
    local old = f(target, function() return "hooked" end)
    if target() ~= "hooked" then return false, "the hook didn't take" end
    return (type(old) == "function" and old() == "original") or false, "the returned original doesn't work"
end)
check("hookfunction (C function)", function()
    local hf, ncc = G("hookfunction") or G("replaceclosure"), G("newcclosure")
    if not (hf and ncc) then return "MISSING", "needs hookfunction + newcclosure" end
    local c = ncc(function() return "original" end)
    local old = hf(c, function() return "hooked" end)
    return (c() == "hooked" and old() == "original") or false, "couldn't hook a C function"
end)
test("restorefunction", nil, function(f)
    local hf = G("hookfunction") or G("replaceclosure")
    if not hf then return true, "present (no hookfunction to test with)" end
    local function target() return "original" end
    hf(target, function() return "hooked" end)
    f(target)
    return target() == "original" or false, "the hook is still there"
end)
test("iscclosure", nil, function(f)
    return (f(print) == true and f(function() end) == false) or false, "print should be a C closure, a Lua function shouldn't"
end)
test("islclosure", nil, function(f)
    return (f(function() end) == true and f(print) == false) or false, "a Lua function should be an L closure, print shouldn't"
end)
test("isexecutorclosure", {"checkclosure", "isourclosure"}, function(f)
    if f(print) then return false, "print counted as an executor function" end
    return f(function() end) or false, "your own script's function didn't count"
end)
test("newcclosure", nil, function(f)
    local function a() return "valor" end
    local c = f(a)
    if c == a or c() ~= "valor" then return false, "wrapped function misbehaves" end
    local isc = G("iscclosure")
    if isc and not isc(c) then return false, "result isn't a C closure" end
    return true
end)
test("newlclosure", nil, function(f)
    local l = f(print)
    if type(l) ~= "function" or l == print then return false, "didn't wrap print" end
    local isl = G("islclosure")
    if isl and not isl(l) then return false, "result isn't a Lua closure" end
    return true
end)
test("getfunctionhash", nil, function(f)
    local a = f(function() return 1 end)
    local b = f(function() return 2 end)
    if type(a) ~= "string" or #a == 0 then return false, "no hash" end
    return a ~= b or false, "two different functions got the same hash"
end)
test("loadstring", nil, function(f)
    local fn = f("return ... + 1")
    if type(fn) ~= "function" or fn(1) ~= 2 then return false, "a simple chunk didn't run" end
    local ok, bad, err = pcall(f, "this is not lua")
    if ok and bad == nil and type(err) == "string" then return true end
    return true, "works (a syntax error raised instead of returning nil, err)"
end)

