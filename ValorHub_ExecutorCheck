extra("File calls keep UI access", function()
    local rf, wf = G("readfile"), G("writefile")
    if not (rf and wf) then return "INFO", "n/a (no file functions)" end
    local label = Instance.new("TextLabel")
    local result, done = nil, false
    task.spawn(function()
