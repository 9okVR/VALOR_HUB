group("Encoding & crypt")
test("crypt.base64encode", {"base64encode", "crypt.base64.encode", "crypt.base64_encode", "base64.encode", "base64_encode"}, function(f)
    return f("test") == "dGVzdA==" or false, "\"test\" didn't encode to dGVzdA=="
end)
test("crypt.base64decode", {"base64decode", "crypt.base64.decode", "crypt.base64_decode", "base64.decode", "base64_decode"}, function(f)
    return f("dGVzdA==") == "test" or false, "dGVzdA== didn't decode to \"test\""
end)
test("crypt.encrypt", nil, function(f)
    local gk, dec = G("crypt.generatekey"), G("crypt.decrypt")
    if not (gk and dec) then return true, "present (needs generatekey + decrypt to test)" end
    local key = gk()
    local data, iv = f("valor", key, nil, "CBC")
    return dec(data, key, iv, "CBC") == "valor" or false, "encrypt -> decrypt didn't give the text back"
end)
test("crypt.decrypt", nil, function(f)
    local gk, enc = G("crypt.generatekey"), G("crypt.encrypt")
    if not (gk and enc) then return true, "present (needs generatekey + encrypt to test)" end
    local key = gk()
    local data, iv = enc("valor", key, nil, "CBC")
    return f(data, key, iv, "CBC") == "valor" or false, "didn't decrypt its own output"
end)
test("crypt.generatebytes", nil, function(f)
    local b = f(16)
    local dec = G("crypt.base64decode") or G("base64decode")
    if dec then return #dec(b) == 16 or false, "16 bytes asked, " .. #dec(b) .. " returned" end
    return type(b) == "string" or false, "didn't return a string"
end)
test("crypt.generatekey", nil, function(f)
    local k = f()
    local dec = G("crypt.base64decode") or G("base64decode")
    if dec then return #dec(k) == 32 or false, "key should be 32 bytes, got " .. #dec(k) end
    return type(k) == "string" or false, "didn't return a string"
end)
test("crypt.hash", nil, function(f)
    local h = f("test", "sha256")
    if type(h) ~= "string" then return false, "didn't return a string" end
    return h:lower() == "9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08" or false, "sha256(\"test\") is wrong"
end)
test("lz4compress", nil, function(f)
    local raw = "valor valor valor valor valor valor"
    local de = G("lz4decompress")
    if not de then return type(f(raw)) == "string" or false, "didn't return a string" end
    return de(f(raw), #raw) == raw or false, "compress -> decompress didn't round-trip"
end)
test("lz4decompress", nil, function(f)
    local co = G("lz4compress")
    if not co then return true, "present (no lz4compress to test with)" end
    local raw = "valor valor valor valor"
    return f(co(raw), #raw) == raw or false, "didn't decompress its own output"
