new("Frame", {Size = UDim2.new(1, -36, 0, 1), Position = UDim2.new(0, 18, 0, hintY + 20), BackgroundColor3 = C.line,
    BorderSizePixel = 0}, win)

-- the list
local listTop = hintY + 24
local list = new("ScrollingFrame", {Size = UDim2.new(1, -24, 1, -(listTop + 30)), Position = UDim2.new(0, 18, 0, listTop),
    BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = C.accent,
    CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y}, win)
new("UIListLayout", {Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder}, list)
new("UIPadding", {PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 4), PaddingBottom = UDim.new(0, 8)}, list)

local rows = {}
local order = 0
for _, g in ipairs(groups) do
    order = order + 1
    local head = new("Frame", {Size = UDim2.new(1, 0, 0, 26), BackgroundTransparency = 1, LayoutOrder = order}, list)
    new("TextLabel", {Size = UDim2.new(1, -80, 1, 0), Position = UDim2.new(0, 8, 0, 0), BackgroundTransparency = 1,
        Text = string.upper(g.name) .. (g.extra and "   ·   EXTRA" or ""), TextColor3 = C.dim, Font = Enum.Font.GothamBold,
        TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom}, head)
    new("TextLabel", {Size = UDim2.new(0, 70, 1, 0), Position = UDim2.new(1, -72, 0, 0), BackgroundTransparency = 1,
        Text = g.total > 0 and (g.pass .. " / " .. g.total) or "", TextColor3 = g.pass == g.total and C.ok or C.warn,
        Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Bottom}, head)
    table.insert(rows, {frame = head, header = true, group = g})
    for _, it in ipairs(g.items) do
        order = order + 1
        local row = new("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = C.card, BackgroundTransparency = 1,
            BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = order}, list)
        corner(row, 4)
        local tag = new("TextLabel", {Size = UDim2.new(0, 58, 0, 18), Position = UDim2.new(0, 6, 0, 3),
            BackgroundColor3 = STATUS_COLOR[it.status] or C.dim, BackgroundTransparency = 0.82, BorderSizePixel = 0,
            Text = it.status, TextColor3 = STATUS_COLOR[it.status] or C.dim, Font = Enum.Font.GothamBold, TextSize = 10}, row)
        corner(tag, 4)
        new("TextLabel", {Size = UDim2.new(0, DETAIL_X - NAME_X - 10, 0, 24), Position = UDim2.new(0, NAME_X, 0, 0),
            BackgroundTransparency = 1, Text = it.name, TextColor3 = C.text, Font = Enum.Font.Code, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd}, row)
        local detail = new("TextLabel", {Size = UDim2.new(1, -(DETAIL_X + 6), 0, 24), Position = UDim2.new(0, DETAIL_X, 0, 0),
            BackgroundTransparency = 1, Text = it.detail or "", TextColor3 = C.dim, Font = Enum.Font.Gotham, TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd}, row)
        local open = false
        row.MouseEnter:Connect(function() row.BackgroundTransparency = 0.4 end)
        row.MouseLeave:Connect(function() row.BackgroundTransparency = open and 0.4 or 1 end)
        row.MouseButton1Click:Connect(function()
            open = not open
            detail.TextWrapped = open
            detail.TextTruncate = open and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd
            detail.TextYAlignment = open and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center
            detail.AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
            detail.Size = UDim2.new(1, -(DETAIL_X + 6), 0, open and 0 or 24)
            if open then new("UIPadding", {Name = "Pad", PaddingTop = UDim.new(0, 5), PaddingBottom = UDim.new(0, 5)}, detail)
            else local p = detail:FindFirstChild("Pad"); if p then p:Destroy() end end
            row.AutomaticSize = open and Enum.AutomaticSize.Y or Enum.AutomaticSize.None
            row.Size = UDim2.new(1, 0, 0, 24)
            row.BackgroundTransparency = open and 0.4 or 1
        end)
        table.insert(rows, {frame = row, item = it, group = g})
    end
end

local function applyFilter()
    for _, r in ipairs(rows) do
        if r.header then
            local any = false
            for _, it in ipairs(r.group.items) do
                if not onlyProblems or (it.status ~= "PASS" and it.status ~= "ALIAS" and it.status ~= "SKIP" and it.status ~= "INFO") then any = true end
            end
            r.frame.Visible = any
        else
            local s = r.item.status
            r.frame.Visible = not onlyProblems or (s ~= "PASS" and s ~= "ALIAS" and s ~= "SKIP" and s ~= "INFO")
        end
    end
    filterBtn.Text = onlyProblems and "Show all" or "Problems only"
    filterBtn.TextColor3 = onlyProblems and C.text or C.dim
end
filterBtn.MouseButton1Click:Connect(function() onlyProblems = not onlyProblems; applyFilter() end)

