group("Game access", true)
extra("require() game module", function()
    local candidates = {}
    local knit = RS:FindFirstChild("Packages") and RS.Packages:FindFirstChild("Knit")
    if knit then table.insert(candidates, knit) end
    for _, root in ipairs({RS, RF}) do
        for _, d in ipairs(root:GetDescendants()) do
            if d:IsA("ModuleScript") then table.insert(candidates, d) end
            if #candidates >= 6 then break end
        end
    end
    if #candidates == 0 then return "INFO", "this game has no ModuleScripts to try" end
    local lastErr
    for _, m in ipairs(candidates) do
        local ok, v = pcall(require, m)
        if ok then return "PASS", "loaded " .. m:GetFullName() end
        lastErr = tostring(v)
    end
    if lastErr and lastErr:find("[Ss]andboxed") then
        return "FAIL", "your scripts run as SANDBOXED threads, so Roblox refuses the game's modules: " .. lastErr
    end
    return "FAIL", lastErr or "require failed"
end, 8)
extra("require() live game copy", function()
    local knit = RS:FindFirstChild("Packages") and RS.Packages:FindFirstChild("Knit")
    if not knit then return "INFO", "n/a in this game (tested in games built on Knit)" end
    local ok, k = pcall(require, knit)
    if not ok then return "FAIL", "can't require Knit: " .. tostring(k) end
    local ok2, err = pcall(function() return k.GetController("GameController") end)
    if ok2 then return "PASS", "Knit is the game's own, already started" end
    if tostring(err):find("started") then
        return "FAIL", "got a FRESH copy (" .. tostring(err) .. ") - scripts can't read the game's live state"
    end
    return "INFO", "Knit loads (this game has no GameController to compare)"
end, 8)
extra("VirtualInputManager", function()
    local ok, v = pcall(game.GetService, game, "VirtualInputManager")
    return (ok and v) and "PASS" or "FAIL", (ok and v) and "available (scripted key presses, clicks)" or "can't press keys / click"
end)
extra("VirtualUser", function()
    local ok, v = pcall(game.GetService, game, "VirtualUser")
    return (ok and v) and "PASS" or "FAIL", (ok and v) and "available (anti-AFK)" or "missing (anti-AFK)"
end)
extra("game:HttpGet", function()
    local t0 = os.clock()
    local ok, body = pcall(function()
        return game:HttpGet("https://raw.githubusercontent.com/9okVR/VALOR_HUB/refs/heads/main/README.md")
    end)
